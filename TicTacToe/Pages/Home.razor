@page "/"

@{
    var computerChar = isUserX ? "⭕" : "❌";
    var userChar = isUserX is false ? "⭕" : "❌";
}

<div class="d-flex flex-column justify-content-center text-center">
    <h3>Compyuter @(computerChar)ni o'ynaydi va siz @(userChar)ni o'ynaysiz.</h3>
    <h3>Hozir @(computersTurn ? "🤖ni navbati" : "🫵ning navbatingiz").</h3>
</div>

<div class="position-absolute top-50 start-50 translate-middle">
    @for(int row = 0; row < 3; row++) {
        <div class="row row-cols-3 mx-auto">
            @for(int column = 0; column < 3; column++) {
                <CardComponent 
                    Data=@TransformIntoData(matrix[row, column]) 
                    OnClicked=@CardClicked
                    Position=@((row, column)) />
            }
        </div>

    }
</div>